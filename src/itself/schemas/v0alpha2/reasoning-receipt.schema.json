{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greaterexpanse.com/itself/schemas/v0alpha2/reasoning-receipt.schema.json",
  "title": "Itself Reasoning Receipt v0alpha2",
  "description": "A deterministic public projection of a validated Claim and Evidence Protocol ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "receipt_id",
    "source_ledger",
    "assurance_basis",
    "limitations",
    "record_counts",
    "subjects",
    "artifacts",
    "tests",
    "evidence",
    "verdicts",
    "transitions",
    "decisions"
  ],
  "properties": {
    "receipt_version": { "const": "0.1.0-alpha.2" },
    "receipt_id": {
      "type": "string",
      "pattern": "^urn:sha256:[0-9a-f]{64}$"
    },
    "source_ledger": { "$ref": "#/$defs/sourceLedger" },
    "assurance_basis": {
      "type": "array",
      "items": {
        "enum": [
          "protocol_schema_conformance",
          "bundle_reference_integrity",
          "deterministic_state_replay",
          "canonical_ledger_digest"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "subjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/subject" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/test" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "verdicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/verdict" }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "referenceList": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "enum": ["sha256", "sha512", "blake3", "other"] },
        "value": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sourceLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "record_count",
        "protocol_versions",
        "digest"
      ],
      "properties": {
        "canonicalization": { "const": "rfc8785-jsonl-v1" },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "protocol_versions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "claimStatus": {
      "enum": [
        "proposed",
        "testable",
        "blocked",
        "under_test",
        "supported",
        "refuted",
        "inconclusive",
        "mixed_evidence",
        "corroborated_within_scope",
        "stale",
        "invalidated",
        "withdrawn"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor_type", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "actor_type": {
          "enum": ["human", "model", "software", "organization"]
        },
        "role": {
          "enum": ["proposer", "evaluator", "reviewer", "authority", "operator"]
        },
        "implementation_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_type", "actor_ref", "basis"],
      "properties": {
        "authority_type": {
          "enum": [
            "deterministic_tool",
            "domain_evaluator",
            "model_evaluator",
            "human_reviewer",
            "policy_engine",
            "external_source"
          ]
        },
        "actor_ref": { "$ref": "#/$defs/identifier" },
        "basis": { "$ref": "#/$defs/nonEmptyString" },
        "independent_of_subject": { "type": "boolean" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "kind",
        "text",
        "scope_description",
        "initial_status",
        "current_status",
        "transition_ids"
      ],
      "properties": {
        "subject_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["claim", "hypothesis"] },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "scope_description": { "$ref": "#/$defs/nonEmptyString" },
        "initial_status": { "$ref": "#/$defs/claimStatus" },
        "current_status": { "$ref": "#/$defs/claimStatus" },
        "transition_ids": { "$ref": "#/$defs/referenceList" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "media_type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "format": "uri-reference" },
        "media_type": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "version", "authority_type"],
      "properties": {
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "authority_type": { "$ref": "#/$defs/authority/properties/authority_type" },
        "declared_scope": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "human_minutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "design",
        "subject_refs",
        "prediction_refs",
        "evidence_refs",
        "oracle"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["planned", "running", "completed", "failed", "unavailable"] },
        "design": { "$ref": "#/$defs/nonEmptyString" },
        "subject_refs": { "$ref": "#/$defs/referenceList" },
        "prediction_refs": { "$ref": "#/$defs/referenceList" },
        "plan_ref": { "$ref": "#/$defs/identifier" },
        "evidence_refs": { "$ref": "#/$defs/referenceList" },
        "oracle": { "$ref": "#/$defs/oracle" },
        "cost": { "$ref": "#/$defs/cost" }
      }
    },
    "evidenceRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "relation"],
      "properties": {
        "subject_ref": { "$ref": "#/$defs/identifier" },
        "relation": { "enum": ["supports", "contradicts", "contextualizes"] },
        "public_note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_type",
        "relations",
        "authority",
        "artifact_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "evidence_type": { "$ref": "#/$defs/nonEmptyString" },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRelation" },
          "minItems": 1
        },
        "authority": { "$ref": "#/$defs/authority" },
        "artifact_refs": { "$ref": "#/$defs/referenceList" },
        "test_ref": { "$ref": "#/$defs/identifier" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_ref",
        "outcome",
        "evidence_refs",
        "authority",
        "public_rationale"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject_ref": { "$ref": "#/$defs/identifier" },
        "outcome": { "$ref": "#/$defs/claimStatus" },
        "evidence_refs": { "$ref": "#/$defs/referenceList" },
        "authority": { "$ref": "#/$defs/authority" },
        "policy_ref": { "$ref": "#/$defs/identifier" },
        "public_rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_ref",
        "from_status",
        "to_status",
        "evidence_refs",
        "authorized_by",
        "reason"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject_ref": { "$ref": "#/$defs/identifier" },
        "from_status": { "$ref": "#/$defs/claimStatus" },
        "to_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_refs": { "$ref": "#/$defs/referenceList" },
        "verdict_ref": { "$ref": "#/$defs/identifier" },
        "authorized_by": { "$ref": "#/$defs/actor" },
        "policy_ref": { "$ref": "#/$defs/identifier" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "to_status": {
                "enum": [
                  "supported",
                  "refuted",
                  "inconclusive",
                  "mixed_evidence",
                  "corroborated_within_scope"
                ]
              }
            },
            "required": ["to_status"]
          },
          "then": { "required": ["verdict_ref"] }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "disposition",
        "authorized_by",
        "relied_on_claim_refs",
        "unresolved_claim_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "question": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": { "enum": ["approved", "rejected", "deferred", "escalated", "executed"] },
        "authorized_by": { "$ref": "#/$defs/actor" },
        "policy_ref": { "$ref": "#/$defs/identifier" },
        "relied_on_claim_refs": { "$ref": "#/$defs/referenceList" },
        "unresolved_claim_refs": { "$ref": "#/$defs/referenceList" }
      }
    }
  }
}
