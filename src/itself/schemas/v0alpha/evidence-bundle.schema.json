{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greaterexpanse.com/itself/schemas/v0alpha/evidence-bundle.schema.json",
  "title": "Itself Evidence Bundle v0alpha",
  "description": "A closed, digest-inventoried package containing an evidence ledger, its reasoning receipt, and referenced artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "bundle_id",
    "title",
    "created_at",
    "closed_artifacts",
    "files",
    "limitations"
  ],
  "properties": {
    "bundle_version": {
      "const": "0.1.0-alpha.1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^urn:sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_artifacts": {
      "const": true
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "media_type",
        "size_bytes",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "input",
            "artifact",
            "ledger",
            "reasoning_receipt",
            "supplemental"
          ]
        },
        "record_ref": {
          "$ref": "#/$defs/identifier"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "artifact"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "record_ref"
            ]
          },
          "else": {
            "not": {
              "required": [
                "record_ref"
              ]
            }
          }
        }
      ]
    }
  }
}
