{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itself:experiments:diagnostician:v1:diagnosis-result",
  "title": "Diagnostician Result v0.2.0",
  "description": "A non-authoritative causal assertion plus invocation provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "diagnostician",
    "assertion",
    "raw_output_artifact",
    "usage"
  ],
  "properties": {
    "contract_version": { "const": "0.2.0" },
    "diagnostician": { "$ref": "#/$defs/diagnostician" },
    "assertion": { "$ref": "#/$defs/assertion" },
    "raw_output_artifact": { "$ref": "#/$defs/artifact" },
    "usage": { "$ref": "#/$defs/usage" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "diagnostician": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type", "adapter_id", "adapter_version"],
      "properties": {
        "actor_id": { "$ref": "#/$defs/identifier" },
        "actor_type": {
          "enum": ["human", "model", "software", "organization"]
        },
        "adapter_id": { "$ref": "#/$defs/identifier" },
        "adapter_version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "test_id",
        "expected_observation",
        "falsified_when"
      ],
      "properties": {
        "hypothesis_id": { "$ref": "#/$defs/identifier" },
        "test_id": { "$ref": "#/$defs/identifier" },
        "expected_observation": { "$ref": "#/$defs/nonEmptyString" },
        "falsified_when": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_hypothesis_ids",
        "primary_hypothesis_id",
        "predictions",
        "selected_test_id",
        "public_explanation"
      ],
      "properties": {
        "retained_hypothesis_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary_hypothesis_id": { "$ref": "#/$defs/identifier" },
        "predictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/prediction" },
          "minItems": 1
        },
        "selected_test_id": { "$ref": "#/$defs/identifier" },
        "public_explanation": { "$ref": "#/$defs/nonEmptyString" },
        "expressed_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "media_type", "digest", "captured_at"],
      "properties": {
        "uri": { "type": "string", "format": "uri-reference" },
        "media_type": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_input_tokens",
        "model_output_tokens",
        "wall_time_ms",
        "human_minutes"
      ],
      "properties": {
        "model_input_tokens": { "type": "integer", "minimum": 0 },
        "model_output_tokens": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "human_minutes": { "type": "number", "minimum": 0 }
      }
    }
  }
}
