{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itself:experiments:trials:v1:trial-manifest",
  "title": "Controlled Model Trial Manifest v0.2.0",
  "description": "A preregistered, credential-free configuration for one controlled model trial series.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "trial_series_id",
    "study_phase",
    "registered_at",
    "case",
    "condition",
    "diagnostician",
    "generation",
    "execution",
    "artifact_policy",
    "metrics",
    "limitations"
  ],
  "properties": {
    "manifest_version": { "const": "0.2.0" },
    "trial_series_id": { "$ref": "#/$defs/identifier" },
    "study_phase": {
      "enum": ["engineering_pilot", "preregistered_study"]
    },
    "registered_at": { "type": "string", "format": "date-time" },
    "case": { "$ref": "#/$defs/case" },
    "condition": {
      "enum": [
        "narrative_diagnosis",
        "structured_without_testing",
        "evidence_enforced"
      ]
    },
    "diagnostician": { "$ref": "#/$defs/diagnostician" },
    "generation": { "$ref": "#/$defs/generation" },
    "execution": { "$ref": "#/$defs/execution" },
    "artifact_policy": { "$ref": "#/$defs/artifactPolicy" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/metric" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_version",
        "diagnosis_contract_version",
        "request_sha256",
        "assertion_schema_sha256"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "case_version": { "$ref": "#/$defs/nonEmptyString" },
        "diagnosis_contract_version": { "$ref": "#/$defs/nonEmptyString" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "assertion_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "diagnostician": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "protocol",
        "adapter_id",
        "adapter_version",
        "base_url_sha256",
        "model"
      ],
      "properties": {
        "actor_id": { "$ref": "#/$defs/identifier" },
        "protocol": { "const": "openai-chat-completions" },
        "adapter_id": { "const": "openai-chat-completions" },
        "adapter_version": { "$ref": "#/$defs/nonEmptyString" },
        "base_url_sha256": { "$ref": "#/$defs/sha256" },
        "model": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structured_output_mode",
        "temperature",
        "seed",
        "max_output_tokens",
        "prompt_payload_sha256"
      ],
      "properties": {
        "structured_output_mode": { "const": "json_schema_strict" },
        "temperature": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 2
        },
        "seed": { "type": ["integer", "null"] },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "prompt_payload_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_count",
        "max_attempts_per_trial",
        "timeout_seconds",
        "automatic_retry",
        "json_repair",
        "fallback"
      ],
      "properties": {
        "trial_count": { "type": "integer", "minimum": 1 },
        "max_attempts_per_trial": { "const": 1 },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "automatic_retry": { "const": false },
        "json_repair": { "const": false },
        "fallback": { "const": false }
      }
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_provider_response",
        "published_representation",
        "credential",
        "private_reasoning"
      ],
      "properties": {
        "raw_provider_response": {
          "enum": ["private", "metadata_only", "ephemeral"]
        },
        "published_representation": { "const": "metadata_and_digest" },
        "credential": { "const": "environment_only" },
        "private_reasoning": { "const": "not_requested" }
      }
    },
    "metric": {
      "enum": [
        "ground_truth_identified",
        "ground_truth_retained",
        "evidence_identifies_ground_truth",
        "false_promotion_attempts",
        "false_promotions_accepted",
        "predictions_evaluated",
        "predictions_correct",
        "tests_executed",
        "discriminating_tests",
        "behavioral_recovery",
        "negative_control_behavioral_recovery",
        "negative_control_addresses_cause",
        "ledger_record_count",
        "model_input_tokens",
        "model_output_tokens",
        "wall_time_ms",
        "receipt_recomputes"
      ]
    }
  }
}
